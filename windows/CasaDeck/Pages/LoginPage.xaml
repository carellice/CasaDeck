<Page x:Class="CasaDeck.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Page.Resources>
        <!-- two soft color blobs drifting behind the card -->
        <Storyboard x:Name="Drift" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BlobA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-160" To="140" Duration="0:0:9" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-120" To="60" Duration="0:0:7" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="180" To="-120" Duration="0:0:11" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="140" To="-40" Duration="0:0:8" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Ellipse x:Name="BlobA" Width="620" Height="620" IsHitTestVisible="False">
            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#665B6CFF" Offset="0" />
                    <GradientStop Color="#005B6CFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="BlobB" Width="560" Height="560" IsHitTestVisible="False">
            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5500C2A8" Offset="0" />
                    <GradientStop Color="#0000C2A8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="420" Padding="32" Margin="0,16" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Border.Transitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="60" /></TransitionCollection>
            </Border.Transitions>
            <StackPanel Spacing="14">
                <Border Width="72" Height="72" CornerRadius="18" HorizontalAlignment="Left">
                    <Image x:Name="Logo" Stretch="UniformToFill" />
                </Border>
                <StackPanel>
                    <TextBlock Text="CasaDeck" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="Il tuo CasaOS, sulla scrivania." Style="{StaticResource Secondary}" />
                </StackPanel>
                <TextBox x:Name="Server" Header="Indirizzo del server" PlaceholderText="http://192.168.1.10" />
                <TextBox x:Name="User" Header="Utente" />
                <PasswordBox x:Name="Pass" Header="Password" KeyDown="Pass_KeyDown" />
                <InfoBar x:Name="Error" Severity="Error" IsClosable="False" />
                <Button x:Name="Go" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="44" Click="Go_Click">
                    <Grid>
                        <TextBlock x:Name="GoText" Text="Accedi" />
                        <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" Foreground="White" />
                    </Grid>
                </Button>
                <TextBlock Text="Usa le stesse credenziali della dashboard web di CasaOS." Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</Page>
