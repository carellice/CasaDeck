<Page x:Class="CasaDeck.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Padding="32,20,32,32" Spacing="16">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="48" /></TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <StackPanel>
                <TextBlock x:Name="Hello" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Server" Style="{StaticResource Secondary}" />
            </StackPanel>
            <InfoBar x:Name="Error" Severity="Error" IsClosable="False" />
            <Grid x:Name="Tiles" ColumnSpacing="16" RowSpacing="16" />
            <Grid x:Name="Lower" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Carico CPU" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="ultimi 90 secondi" Style="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Canvas x:Name="Chart" Height="170" SizeChanged="Chart_SizeChanged">
                            <Polygon x:Name="ChartFill">
                                <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#665B6CFF" Offset="0" />
                                        <GradientStop Color="#005B6CFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Polygon.Fill>
                            </Polygon>
                            <Polyline x:Name="ChartLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </StackPanel>
                </Border>
                <Border x:Name="NetCard" Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Rete" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#2200C2A8">
                                <FontIcon Glyph="&#xE896;" Foreground="#00C2A8" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Download" Style="{StaticResource Secondary}" />
                                <TextBlock x:Name="Down" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#22FFA63D">
                                <FontIcon Glyph="&#xE898;" Foreground="#FFA63D" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Upload" Style="{StaticResource Secondary}" />
                                <TextBlock x:Name="Up" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
