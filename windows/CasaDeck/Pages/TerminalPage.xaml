<Page x:Class="CasaDeck.Pages.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Terminale" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Accesso SSH al tuo server, come nella dashboard web di CasaOS." Style="{StaticResource Secondary}" />
            </StackPanel>
            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Click="Reconnect_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Riconnetti" /></StackPanel>
                </Button>
                <Button Click="Disconnect_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xF3B1;" FontSize="14" /><TextBlock Text="Disconnetti" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="LoginCard" Grid.Row="1" Style="{StaticResource Card}" Width="440" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="28">
            <Border.Transitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="40" /></TransitionCollection>
            </Border.Transitions>
            <StackPanel Spacing="14">
                <Border Width="52" Height="52" CornerRadius="16" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE756;" Foreground="White" FontSize="24" />
                </Border>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SshUser" Header="Utente" />
                    <NumberBox x:Name="SshPort" Grid.Column="1" Header="Porta" Minimum="1" Maximum="65535" />
                </Grid>
                <PasswordBox x:Name="SshPass" Header="Password SSH" KeyDown="SshPass_KeyDown" />
                <TextBlock Text="La password resta solo in memoria finché l'app è aperta." Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="44" Click="Connect_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE945;" FontSize="16" /><TextBlock Text="Connetti" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="TermCard" Grid.Row="1" CornerRadius="14" Background="#0B0D12" Padding="6" Visibility="Collapsed">
            <WebView2 x:Name="Web" DefaultBackgroundColor="#0B0D12" />
        </Border>
    </Grid>
</Page>
