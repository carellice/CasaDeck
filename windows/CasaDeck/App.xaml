<Application x:Class="CasaDeck.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- CasaDeck indigo, same as the Android app -->
            <Color x:Key="SystemAccentColor">#5B6CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#7482FF</Color>
            <Color x:Key="SystemAccentColorLight2">#8D99FF</Color>
            <Color x:Key="SystemAccentColorLight3">#AAB3FF</Color>
            <Color x:Key="SystemAccentColorDark1">#4C5CE6</Color>
            <Color x:Key="SystemAccentColorDark2">#3D4BC4</Color>
            <Color x:Key="SystemAccentColorDark3">#2F3AA0</Color>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
